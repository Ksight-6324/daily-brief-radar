[Unit]
Description=Daily Brief Radar health check

[Service]
Type=oneshot
User=brief
Group=brief
WorkingDirectory=/opt/brief/app
EnvironmentFile=/etc/brief/brief.env
Environment=BRIEF_BACKUP_DIR=/var/backups/brief
# Ping only after a healthy check. Missing pings also detect a whole-server outage.
ExecStart=/opt/brief/venv/bin/python -m subscription.cli check --ping

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/brief
