# Production settings for the systemd install. Copy to /etc/brief/brief.env (mode 640, owner root, group brief).
# For Docker Compose use the repository's .env instead (see .env.example plus DOMAIN).
BRIEF_MODE=subscription
BRIEF_DB_PATH=/var/lib/brief/brief.db
BRIEF_SEEN_FILE=/var/lib/brief/seen_items.json
PUBLIC_BASE_URL=https://your-domain.example
# Stable random value of at least 32 characters:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Back it up separately from the database. Without it every issued link stops working.
BRIEF_TOKEN_SECRET=

RESEND_API_KEY=
RESEND_FROM=Daily Brief Radar <brief@your-domain.example>

DEEPSEEK_API_KEY=
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=0

# Shown on the privacy policy and terms pages.
CONTACT_EMAIL=
OPERATOR_NAME=

# Optional dead-man's-switch URL. The health check pings it only while everything is healthy.
HEALTHCHECK_PING_URL=
