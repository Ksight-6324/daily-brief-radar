# Copy this file to .env and fill the values locally. Keep production .env private.
BRIEF_MODE=museletter
# Content ledger only. Subscribers live in the separate Museletter database.
BRIEF_PUBLISH_DB_PATH=var/publisher.db
BRIEF_SEEN_FILE=var/seen_items.json
MUSELETTER_URL=http://127.0.0.1:8000
MUSELETTER_API_KEY=
MUSELETTER_LIST=default
MUSELETTER_TAG=
# false keeps the engine test-send prerequisite. Enable only after reviewing a test email.
MUSELETTER_SKIP_TEST=false
# Public HTTPS origin for reader confirmation and unsubscribe links.
# localhost is usable only for development on this computer.
MUSELETTER_BASE_URL=http://127.0.0.1:8000
MUSELETTER_DB_PATH=var/museletter.db
MUSELETTER_FROM_EMAIL=
MUSELETTER_FROM_NAME=Daily Brief Radar
MUSELETTER_POSTAL_ADDRESS=
MUSELETTER_OPT_IN=double
MUSELETTER_EMAIL_PROVIDER=ses
MUSELETTER_SEND_RATE=1
MUSELETTER_SES_CONFIGURATION_SET=
MUSELETTER_SNS_TOPIC_ARN=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional Cloudflare provider. Set MUSELETTER_EMAIL_PROVIDER=cloudflare.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
MUSELETTER_CLOUDFLARE_EVENTS_QUEUE_ID=

# Legacy paid subscription mode uses the following settings.
BRIEF_DB_PATH=var/brief.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Shown on the privacy policy page. Set both before the site is public.
CONTACT_EMAIL=
OPERATOR_NAME=
# Use a stable random secret of at least 32 characters, or back up the generated .db.key file.
BRIEF_TOKEN_SECRET=

# Verified sender domain/address in your Resend account.
RESEND_API_KEY=
RESEND_FROM=

# Existing DeepSeek generator. Alternatively configure the existing LLM_* variables.
DEEPSEEK_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_REASONING_EFFORT=

# Alipay face-to-face payment in public-key mode. Keys are PEM, with literal \n for line breaks.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SANDBOX=0

# Docker Compose only: the public domain Caddy serves and gets a certificate for.
DOMAIN=
# Optional dead-man's-switch URL pinged by the health check while everything is healthy.
HEALTHCHECK_PING_URL=
